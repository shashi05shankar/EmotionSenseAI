# EmotionSense AI — environment template. Copy to .env and fill in. NEVER commit .env.
# All app settings are prefixed ESA_ and override configs/app/*.yaml.

# --- Core ---
ESA_ENV=local                       # local | ci | prod
ESA_LOG_LEVEL=INFO

# --- Database (PostgreSQL) ---
ESA_DB_URL=postgresql+psycopg2://esa:esa@localhost:5432/emotionsense

# --- Object storage (MinIO / S3) ---
ESA_S3_ENDPOINT=http://localhost:9000
ESA_S3_ACCESS_KEY=minioadmin
ESA_S3_SECRET_KEY=minioadmin
ESA_S3_BUCKET=emotionsense
ESA_S3_REGION=us-east-1

# --- Experiment tracking (MLflow) ---
ESA_MLFLOW_TRACKING_URI=http://localhost:5000

# --- Auth ---
ESA_JWT_SECRET=change-me-in-prod
ESA_JWT_ALGORITHM=HS256
ESA_JWT_EXPIRE_MINUTES=60

# --- Serving ---
ESA_DEFAULT_MODEL=svm-ravdess:v1    # production default served by /predict
ESA_MAX_UPLOAD_MB=10
ESA_MAX_DURATION_SEC=30
ESA_MODEL_CACHE_SIZE=3

# --- Frontend ---
ESA_API_BASE_URL=http://localhost:8000/api/v1
